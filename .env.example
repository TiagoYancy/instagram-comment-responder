# ==========================================================================
# Credenciais da Instagram Graph API
# ==========================================================================
# Instagram API with Instagram Login (Business Login for Instagram):
#   - App no Meta for Developers -> Instagram -> API setup with Instagram login
#   - Permissões: instagram_business_basic + instagram_business_manage_comments
#   - A conta precisa ser Profissional (Comercial ou de Criador)
#   - Gere o token em: API setup with Instagram login -> Generate token
IG_ACCESS_TOKEN=
IG_USER_ID=

# Host da API: graph.instagram.com (Instagram Login)
#              graph.facebook.com  (Facebook Login / Page token)
IG_GRAPH_HOST=https://graph.instagram.com
IG_GRAPH_VERSION=v23.0

# ==========================================================================
# Modo de operação  (approve | auto | dry_run)
# ==========================================================================
#   approve -> gera rascunhos e ESPERA sua aprovação antes de publicar
#   auto    -> publica 100% sozinho quando a confiança >= IG_MIN_CONFIDENCE
#   dry_run -> nunca publica, apenas registra o que faria  (default seguro)
IG_APPROVAL_MODE=dry_run

# Confiança mínima para publicar sem revisão humana (0.0 a 1.0)
IG_MIN_CONFIDENCE=0.75

# Teto de respostas publicadas por execução (freio anti-loop)
IG_MAX_REPLIES=20

# Pausa (segundos) entre publicações, para parecer humano
IG_REPLY_DELAY=12

# ==========================================================================
# Motor de linguagem (opcional)
# ==========================================================================
# Qualquer endpoint OpenAI-compatible serve. Por padrão usa o próprio
# Hermes API server local, que já tem o modelo configurado.
IG_LLM_ENABLED=1
IG_LLM_BASE_URL=http://127.0.0.1:8642/v1
IG_LLM_API_KEY=
IG_LLM_MODEL=hermes-agent
IG_LLM_TIMEOUT=120
